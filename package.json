{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.18",
    "npm": ">=10"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@workspace/african-air-db",
    "dev:api": "npm run dev --workspace=@workspace/api-server",
    "dev:mockup": "npm run dev --workspace=@workspace/mockup-sandbox",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "codegen": "npm run codegen --workspace=@workspace/api-spec",
    "db:push": "npm run push --workspace=@workspace/db"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
